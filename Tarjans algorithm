def tarjans_scc(graph):
    n = len(graph)
    ids = [-1] * n
    low = [0] * n
    on_stack = [False] * n
    stack = []
    id = 0
    scc_count = 0

    def dfs(at):
        nonlocal id, scc_count
        stack.append(at)
        on_stack[at] = True
        ids[at] = low[at] = id
        id += 1

        for to in graph[at]:
            if ids[to] == -1:
                dfs(to)
                low[at] = min(low[at], low[to])
            elif on_stack[to]:
                low[at] = min(low[at], ids[to])

        if ids[at] == low[at]:
            print("SCC:", end=" ")
            while True:
                node = stack.pop()
                on_stack[node] = False
                print(node, end=" ")
                if node == at:
                    break
            print()
            scc_count += 1

    for i in range(n):
        if ids[i] == -1:
            dfs(i)


graph = [[1], [2], [0,3], [4], []]
tarjans_scc(graph)
